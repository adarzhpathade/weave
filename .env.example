# Copy to .env.local and fill in. Validated by lib/envSchema.ts (the app refuses to start if a required one is wrong).
# Neon project: "weave" (aws-ap-southeast-1). Values: Neon console → Connect, or the Neon MCP/CLI.

# --- Database (required) ---
# Pooled URL (host contains "-pooler") for the app; direct URL for drizzle-kit migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.c-5.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.c-5.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Neon Auth / Managed Better Auth (required) ---
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.c-5.ap-southeast-1.aws.neon.tech/neondb/auth
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=
# Optional extra check: comma-separated college email domains, e.g. abc.edu.in. The real gate is the student list.
ALLOWED_EMAIL_DOMAINS=

# --- Neon Object Storage, S3-compatible (required) ---
# Credential with storage:read + storage:write scopes (Neon console → Settings → Credentials).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-5.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1
STORAGE_BUCKET_MATERIALS=materials

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (Phase 4 extra, optional until then) ---
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Web push + cron (Phase 2.6, optional until then) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
SESSION_SECRET=
